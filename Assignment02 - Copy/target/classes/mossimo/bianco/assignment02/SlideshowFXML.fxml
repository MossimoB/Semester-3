<?xml version="1.0" encoding="UTF-8"?>

<!--
    Intro slideshow: greeting, one car picture at a time, and a Skip button.
    @author Mossimo Bianco
-->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mossimo.bianco.assignment02.controller.SlideshowController"
            styleClass="slideshow-root" prefWidth="1000" prefHeight="720">
    <top>
        <VBox alignment="CENTER" spacing="4" styleClass="slideshow-header">
            <Label text="Welcome to the Grand Prix!" styleClass="greeting-title"/>
            <Label text="Meet today's five racers before the lights go out" styleClass="greeting-subtitle"/>
        </VBox>
    </top>
    <center>
        <VBox alignment="CENTER" spacing="14">
            <StackPane styleClass="image-frame" maxWidth="664" maxHeight="384">
                <ImageView fx:id="carImageView" fitWidth="640" fitHeight="360" preserveRatio="true"/>
            </StackPane>
            <Label fx:id="carNameLabel" styleClass="car-name"/>
            <Label fx:id="carDetailsLabel" styleClass="car-details"/>
            <HBox fx:id="dotsBox" alignment="CENTER" spacing="10"/>
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="slideshow-footer">
            <Label fx:id="slideCounterLabel" styleClass="slide-counter"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Skip Intro" onAction="#handleSkip" styleClass="skip-button"/>
        </HBox>
    </bottom>
</BorderPane>
