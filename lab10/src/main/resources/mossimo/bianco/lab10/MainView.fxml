<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.CheckMenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="mainPane"
            prefHeight="400.0"
            prefWidth="600.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="mossimo.bianco.lab10.MainViewController">

    <children>

        <MenuBar AnchorPane.leftAnchor="0.0"
                 AnchorPane.rightAnchor="0.0"
                 AnchorPane.topAnchor="0.0">

            <menus>

                <Menu text="_File" mnemonicParsing="true">

                    <items>
                        <MenuItem fx:id="newItem"
                                  text="New"
                                  onAction="#handleNew"/>

                        <MenuItem fx:id="openItem"
                                  text="Open"
                                  onAction="#handleOpen"/>

                        <MenuItem fx:id="closeItem"
                                  text="Close"
                                  onAction="#handleClose"/>

                        <MenuItem fx:id="saveItem"
                                  text="Save As"/>
                    </items>

                </Menu>

                <Menu text="_Edit" mnemonicParsing="true">

                    <items>

                        <CheckMenuItem fx:id="gridItem"
                                       text="Use GridLines"
                                       onAction="#handleGrid"/>

                        <MenuItem fx:id="copyItem"
                                  text="Copy"
                                  onAction="#handleCopy"/>

                        <Menu fx:id="searchMenu"
                              text="_Search"
                              mnemonicParsing="true">

                            <items>

                                <MenuItem fx:id="findItem"
                                          text="Find"
                                          onAction="#handleFind"/>

                                <MenuItem fx:id="replaceItem"
                                          text="Replace"
                                          onAction="#handleReplace"/>

                            </items>

                        </Menu>

                    </items>

                </Menu>

                <Menu text="_Settings" mnemonicParsing="true">

                    <items>

                        <RadioMenuItem fx:id="smallItem"
                                       text="Small"
                                       onAction="#handleSizeSmall"/>

                        <RadioMenuItem fx:id="mediumItem"
                                       text="Medium"
                                       onAction="#handleSizeMedium"/>

                        <RadioMenuItem fx:id="largeItem"
                                       text="Large"
                                       onAction="#handleSizeLarge"/>

                    </items>

                </Menu>

            </menus>

        </MenuBar>

    </children>

</AnchorPane>