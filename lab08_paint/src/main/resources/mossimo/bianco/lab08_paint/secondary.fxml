              BorderPane.alignment="CENTER">

            <padding>
                <Insets right="8.0"/>
            </padding>

            <TitledPane text="Drawing Color" expanded="true">
                <content>
                    <VBox spacing="8.0">
                        <RadioButton fx:id="blackRadioButton"
                                     text="Black"
                                     selected="true"
                                     onAction="#colorRadioButtonSelected">
                            <toggleGroup>
                                <ToggleGroup fx:id="colorToggleGroup"/>
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="redRadioButton"
                                     text="Red"
                                     toggleGroup="$colorToggleGroup"
                                     onAction="#colorRadioButtonSelected"/>

                        <RadioButton fx:id="blueRadioButton"
                                     text="Blue"
                                     toggleGroup="$colorToggleGroup"
                                     onAction="#colorRadioButtonSelected"/>

                        <RadioButton fx:id="greenRadioButton"
                                     text="Green"
                                     toggleGroup="$colorToggleGroup"
                                     onAction="#colorRadioButtonSelected"/>
                    </VBox>
                </content>
            </TitledPane>

            <TitledPane text="Pen Size" expanded="true">
                <content>
                    <VBox spacing="8.0">
                        <RadioButton fx:id="smallRadioButton"
                                     text="Small"
                                     onAction="#sizeRadioButtonSelected">
                            <toggleGroup>
                                <ToggleGroup fx:id="sizeToggleGroup"/>
                            </toggleGroup>
                        </RadioButton>

                        <RadioButton fx:id="mediumRadioButton"
                                     text="Medium"
                                     selected="true"
                                     toggleGroup="$sizeToggleGroup"
                                     onAction="#sizeRadioButtonSelected"/>

                        <RadioButton fx:id="largeRadioButton"
                                     text="Large"
                                     toggleGroup="$sizeToggleGroup"
                                     onAction="#sizeRadioButtonSelected"/>
                    </VBox>
                </content>
            </TitledPane>

            <Button text="Undo"
                    maxWidth="Infinity"
                    onAction="#undoButtonPressed"/>

            <Button text="Clear"
                    maxWidth="Infinity"
                    onAction="#clearButtonPressed"/>

        </VBox>
    </left>

    <center>
        <Pane fx:id="drawingAreaPane"
              maxWidth="Infinity"
              maxHeight="Infinity"
              style="-fx-background-color: white;"
              onMouseDragged="#drawingAreaMouseDragged"/>
    </center>

</BorderPane>
